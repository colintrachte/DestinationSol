<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="STDOUT" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %5p [%t] (%F:%L) - %m%n"/>
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </Console>
        <RollingFile name="FILE" fileName="destinationsol.log" filePattern="destinationsol-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%t] (%F:%L) - %m%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="3"/>
            <ThresholdFilter level="DEBUG" onMatch="ACCEPT" onMismatch="DENY"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="deng" level="DEBUG"/>

        <!-- GameMaker-ported modules. Set to INFO to mute their per-tick heartbeats. -->
        <Logger name="org.destinationsol.modules.gravity" level="DEBUG"/>
        <Logger name="org.destinationsol.modules.vfx" level="DEBUG"/>
        <Logger name="org.destinationsol.modules.astrobodies" level="DEBUG"/>

        <Root level="DEBUG">
            <AppenderRef ref="STDOUT"/>
            <AppenderRef ref="FILE"/>
        </Root>
    </Loggers>
</Configuration>
